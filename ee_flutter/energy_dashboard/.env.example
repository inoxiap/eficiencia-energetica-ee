FIREBASE_PROJECT_ID=eficiencia-energetica-ee
FIRESTORE_EMULATOR_HOST=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
FIREBASE_WEB_API_KEY=replace-with-the-public-firebase-web-api-key
DASHBOARD_SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_COOKIE_SECURE=true
DASHBOARD_QUERY_LIMIT=50000
DASHBOARD_BATCH_SIZE=500
DEFAULT_TIMEZONE=America/Guayaquil
