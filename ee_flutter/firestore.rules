rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isProvider() {
      return signedIn() && (
        request.auth.token.role == 'provider'
        || (userProfileExists() && userProfile().role == 'provider')
      );
    }

    function providerCredentialIsValid() {
      return !isProvider() || (
        userProfileExists()
        && userProfile().active == true
        && userProfile().credentialExpiresAt is timestamp
        && userProfile().credentialExpiresAt > request.time
      );
    }

    function internalUser() {
      return signedIn()
        && !isProvider()
        && (
          request.auth.token.role in ['operator', 'admin']
          || (
            userProfileExists()
            && userProfile().role in ['operator', 'admin']
          )
        );
    }

    function hasTrapAccess() {
      return internalUser()
        || (isProvider() && providerCredentialIsValid());
    }

    function currentCompanyId() {
      return userProfileExists() && userProfile().companyId is string
        ? userProfile().companyId
        : '';
    }

    function currentCompanyName() {
      return userProfileExists() && userProfile().companyNameSnapshot is string
        ? userProfile().companyNameSnapshot
        : '';
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.role == 'admin'
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function canReadSteamTrap() {
      return hasTrapAccess() && (
        resource.data.ownerUid == request.auth.uid
        || (
          resource.data.companyId is string
          && resource.data.companyId.size() > 0
          && resource.data.companyId == currentCompanyId()
        )
        || (
          resource.data.isDemo == true
          && resource.data.sharedWithUids is list
          && resource.data.sharedWithUids.hasAny([request.auth.uid])
        )
      );
    }

    function companyFieldsMatchCurrentUser() {
      return request.resource.data.companyId is string
        && request.resource.data.companyId == currentCompanyId()
        && request.resource.data.companyNameSnapshot is string
        && request.resource.data.companyNameSnapshot == currentCompanyName()
        && request.resource.data.isDemo == false
        && request.resource.data.sharedWithUids is list
        && request.resource.data.sharedWithUids.size() == 0;
    }

    function createsOwnRecord() {
      return signedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.source == 'manual'
        && request.resource.data.platform in ['android', 'web']
        && request.resource.data.schemaVersion is int;
    }

    function readsOwnRecord() {
      return internalUser()
        && resource.data.createdByUid == request.auth.uid;
    }

    function ownsSteamTrap() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function validSteamTrapCore() {
      return request.resource.data.id is string
        && request.resource.data.tag is string
        && request.resource.data.tag.matches('^TV-[0-9][0-9]-[0-9]+$')
        && request.resource.data.tagLocked == true
        && request.resource.data.sectionCode is string
        && request.resource.data.sectionCode.matches('^[0-9][0-9]$')
        && request.resource.data.sectionId is string
        && request.resource.data.sectionNameSnapshot is string
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerNameSnapshot is string
        && (!request.resource.data.keys().hasAny(['companyId'])
          || request.resource.data.companyId is string)
        && (!request.resource.data.keys().hasAny(['companyNameSnapshot'])
          || request.resource.data.companyNameSnapshot is string)
        && (!request.resource.data.keys().hasAny(['isDemo'])
          || request.resource.data.isDemo is bool)
        && (!request.resource.data.keys().hasAny(['sharedWithUids'])
          || request.resource.data.sharedWithUids is list)
        && request.resource.data.photoProvider == 'cloudinary'
        && request.resource.data.status in ['draft', 'complete', 'upload_failed']
        && request.resource.data.diagnosisStatus
          in ['pending', 'operational', 'requires_attention', 'out_of_service']
        && request.resource.data.entryMode
          in ['new_entry', 'inventory_validation'];
    }

    function validCompletedSteamTrap() {
      return request.resource.data.status != 'complete' || (
        request.resource.data.zone is string
        && request.resource.data.zone.size() > 0
        && request.resource.data.equipmentName is string
        && request.resource.data.equipmentName.size() > 0
        && request.resource.data.serviceId is string
        && request.resource.data.serviceId.size() > 0
        && request.resource.data.diameter is string
        && request.resource.data.diameter.size() > 0
        && request.resource.data.trapTypeId is string
        && request.resource.data.trapTypeId.size() > 0
        && request.resource.data.condensateRecovery
          in ['yes', 'no', 'to_confirm']
        && request.resource.data.closePhoto is map
        && request.resource.data.closePhoto.ownerUid == request.resource.data.ownerUid
        && request.resource.data.closePhoto.tag == request.resource.data.tag
        && request.resource.data.generalPhoto is map
        && request.resource.data.generalPhoto.ownerUid == request.resource.data.ownerUid
        && request.resource.data.generalPhoto.tag == request.resource.data.tag
      );
    }

    function preservesSteamTrapIdentity() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.tag == resource.data.tag
        && request.resource.data.tagLocked == resource.data.tagLocked
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (!resource.data.keys().hasAny(['companyId'])
          || request.resource.data.companyId == resource.data.companyId)
        && (!resource.data.keys().hasAny(['isDemo'])
          || request.resource.data.isDemo == resource.data.isDemo)
        && (!resource.data.keys().hasAny(['sharedWithUids'])
          || request.resource.data.sharedWithUids == resource.data.sharedWithUids)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid;
    }

    function validAdminSteamTrapCorrection() {
      return isAdmin()
        && (
          request.resource.data.sectionCode == resource.data.sectionCode
          || (
            request.resource.data.sectionHistory is list
            && resource.data.sectionHistory is list
            && request.resource.data.sectionHistory.size()
              == resource.data.sectionHistory.size() + 1
          )
        );
    }

    function updatesMaintenanceWorkflow() {
      return internalUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'workOrderCreated',
          'workOrderCreatedAt',
          'workOrderCreatedByUid',
          'workOrderCreatedByNameSnapshot',
          'workCompleted',
          'workCompletedAt',
          'workCompletedByUid',
          'workCompletedByNameSnapshot',
          'status',
          'updatedAt',
          'updatedByUid'
        ])
        && request.resource.data.workOrderCreated is bool
        && request.resource.data.workCompleted is bool
        && (!request.resource.data.workCompleted || request.resource.data.workOrderCreated)
        && request.resource.data.status in ['open', 'work_order_created', 'completed']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
    }

    function validLeakDestination() {
      return request.resource.data.sectionCode is string
        && request.resource.data.processCode is string
        && request.resource.data.equipmentCode is string
        && request.resource.data.systemCode is string
        && request.resource.data.destinationId is string
        && request.resource.data.selectionDepth
          in ['none', 'section', 'process', 'equipment', 'system']
        && request.resource.data.sectionId == request.resource.data.sectionCode
        && (
          (
            request.resource.data.selectionDepth == 'none'
            && request.resource.data.sectionCode == ''
            && request.resource.data.processCode == ''
            && request.resource.data.equipmentCode == ''
            && request.resource.data.systemCode == ''
            && request.resource.data.destinationId == ''
          )
          || (
            request.resource.data.selectionDepth == 'section'
            && request.resource.data.sectionCode.size() > 0
            && request.resource.data.processCode == ''
            && request.resource.data.equipmentCode == ''
            && request.resource.data.systemCode == ''
            && request.resource.data.destinationId == ''
          )
          || (
            request.resource.data.selectionDepth == 'process'
            && request.resource.data.sectionCode.size() > 0
            && request.resource.data.processCode.size() > 0
            && request.resource.data.equipmentCode == ''
            && request.resource.data.systemCode == ''
            && request.resource.data.destinationId == ''
          )
          || (
            request.resource.data.selectionDepth == 'equipment'
            && request.resource.data.sectionCode.size() > 0
            && request.resource.data.processCode.size() > 0
            && request.resource.data.equipmentCode.size() > 0
            && request.resource.data.systemCode == ''
          )
          || (
            request.resource.data.selectionDepth == 'system'
            && request.resource.data.sectionCode.size() > 0
            && request.resource.data.processCode.size() > 0
            && request.resource.data.equipmentCode.size() > 0
            && request.resource.data.systemCode.size() > 0
            && request.resource.data.destinationId.size() > 0
          )
        );
    }

    function validCleaverDistributorPressures(values) {
      return values is map
        && values.keys().hasOnly([
          'omega',
          'lambda',
          'omicron',
          'beta',
          'hydrogenation'
        ])
        && values.keys().hasAll([
          'omega',
          'lambda',
          'omicron',
          'beta',
          'hydrogenation'
        ])
        && values.omega is number && values.omega >= 0
        && values.lambda is number && values.lambda >= 0
        && values.omicron is number && values.omicron >= 0
        && values.beta is number && values.beta >= 0
        && values.hydrogenation is number && values.hydrogenation >= 0;
    }

    function validDistral900DistributorPressures(values) {
      return values is map
        && values.keys().hasOnly([
          'soapPlant',
          'desmetTirtioux',
          'newLine',
          'cleaverInlet',
          'bleachers',
          'marino',
          'padLoading',
          'receptionTanks',
          'waterTank4'
        ])
        && values.keys().hasAll([
          'soapPlant',
          'desmetTirtioux',
          'newLine',
          'cleaverInlet',
          'bleachers',
          'marino',
          'padLoading',
          'receptionTanks',
          'waterTank4'
        ])
        && values.soapPlant is number && values.soapPlant >= 0
        && values.desmetTirtioux is number && values.desmetTirtioux >= 0
        && values.newLine is number && values.newLine >= 0
        && values.cleaverInlet is number && values.cleaverInlet >= 0
        && values.bleachers is number && values.bleachers >= 0
        && values.marino is number && values.marino >= 0
        && values.padLoading is number && values.padLoading >= 0
        && values.receptionTanks is number && values.receptionTanks >= 0
        && values.waterTank4 is number && values.waterTank4 >= 0;
    }

    match /app_config/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /catalog_sections/{document} {
      allow read: if internalUser();
      allow write: if false;
    }

    match /motor_reference_tables/{document} {
      allow read: if internalUser();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /user_private_credentials/{document} {
      allow read, write: if false;
    }

    match /audit_logs/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /steam_trap_sizing_reports/{document} {
      allow create: if internalUser()
        && createsOwnRecord()
        && request.resource.data.sectionId is string
        && request.resource.data.equipmentName is string
        && request.resource.data.calculationMethod
          in ['direct', 'indirect', 'direct_selection'];
      allow read: if isAdmin() || readsOwnRecord();
      allow update, delete: if false;
    }

    match /steam_trap_records/{document} {
      allow create: if hasTrapAccess()
        && createsOwnRecord()
        && validSteamTrapCore()
        && validCompletedSteamTrap()
        && companyFieldsMatchCurrentUser()
        && request.resource.data.id == document
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerNameSnapshot
          == request.resource.data.createdByNameSnapshot;
      allow read: if isAdmin() || canReadSteamTrap();
      allow update: if validSteamTrapCore()
        && validCompletedSteamTrap()
        && preservesSteamTrapIdentity()
        && (
          validAdminSteamTrapCorrection()
          || (
            hasTrapAccess()
            && ownsSteamTrap()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'zone',
              'equipmentName',
              'equipmentNameNormalized',
              'serviceId',
              'serviceNameSnapshot',
              'diameter',
              'trapTypeId',
              'trapTypeNameSnapshot',
              'condensateRecovery',
              'comments',
              'diagnosisStatus',
              'entryMode',
              'status',
              'closePhoto',
              'generalPhoto',
              'updatedAt',
              'updatedByUid',
              'appVersion'
            ])
            && request.resource.data.updatedAt == request.time
            && request.resource.data.updatedByUid == request.auth.uid
          )
        );
      allow delete: if false;
    }

    match /steam_trap_counters/{sectionCode} {
      allow read: if hasTrapAccess();
      allow create: if hasTrapAccess()
        && request.resource.data.keys().hasOnly([
          'sectionCode', 'lastNumber', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.sectionCode == sectionCode
        && request.resource.data.lastNumber == 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow update: if hasTrapAccess()
        && request.resource.data.keys().hasOnly([
          'sectionCode', 'lastNumber', 'updatedAt', 'updatedByUid'
        ])
        && request.resource.data.sectionCode == resource.data.sectionCode
        && request.resource.data.lastNumber == resource.data.lastNumber + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /bare_pipe_reports/{document} {
      allow create: if internalUser()
        && createsOwnRecord()
        && request.resource.data.sectionId is string
        && request.resource.data.equipmentName is string
        && request.resource.data.photoProvider == 'cloudinary';
      allow read: if internalUser();
      allow update: if updatesMaintenanceWorkflow();
      allow delete: if false;
    }

    match /leak_reports/{document} {
      allow create: if internalUser()
        && createsOwnRecord()
        && request.resource.data.sectionId is string
        && request.resource.data.equipmentName is string
        && (
          (
            request.resource.data.schemaVersion == 1
            && request.resource.data.leakType
              in ['steam', 'oil', 'water', 'air']
          )
          || (
            request.resource.data.schemaVersion >= 2
            && validLeakDestination()
            && request.resource.data.leakType
              in ['steam', 'condensate', 'oil', 'water', 'air']
            && request.resource.data.leakNumber is int
            && request.resource.data.leakNumber > 0
          )
        )
        && request.resource.data.tagNumber is string
        && request.resource.data.tagNumber.size() > 0
        && request.resource.data.photoProvider == 'cloudinary'
        && request.resource.data.workOrderCreated == false
        && request.resource.data.workCompleted == false;
      allow read: if internalUser();
      allow update: if updatesMaintenanceWorkflow();
      allow delete: if false;
    }

    match /maintenance_counters/leak_reports {
      allow read: if internalUser();
      allow create: if internalUser()
        && request.resource.data.keys().hasOnly([
          'nextNumber',
          'updatedAt',
          'updatedByUid'
        ])
        && request.resource.data.nextNumber == 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow update: if internalUser()
        && request.resource.data.keys().hasOnly([
          'nextNumber',
          'updatedAt',
          'updatedByUid'
        ])
        && request.resource.data.nextNumber == resource.data.nextNumber + 1
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;
    }

    match /boiler_consumption_readings/{document} {
      allow create: if internalUser()
        && createsOwnRecord()
        && request.resource.data.boilerId is string
        && request.resource.data.readingMode == 'cumulative_meter'
        && (
          request.resource.data.schemaVersion == 1
          || (
            request.resource.data.schemaVersion >= 2
            && request.resource.data.boilerPressurePsi is number
            && request.resource.data.boilerPressurePsi >= 0
            && request.resource.data.boilerPressureUnit == 'psi'
          )
        )
        && !request.resource.data.keys().hasAny(['operatorPin']);
      allow read: if internalUser();
      allow update, delete: if false;
    }

    match /steam_pressure_readings/{document} {
      allow create: if internalUser()
        && createsOwnRecord()
        && request.resource.data.pressureUnit == 'psi'
        && request.resource.data.sectionId == 'servicios_industriales'
        && request.resource.data.equipmentName is string
        && validCleaverDistributorPressures(
          request.resource.data.cleaverDistributorPsi
        )
        && validDistral900DistributorPressures(
          request.resource.data.distral900DistributorPsi
        );
      allow read: if isAdmin() || readsOwnRecord();
      allow update, delete: if false;
    }

    match /pump_energy_surveys/{document} {
      allow create: if internalUser()
        && createsOwnRecord()
        && request.resource.data.assetId is string
        && request.resource.data.surveyType
          in ['baseline', 'post_improvement', 'verification'];
      allow read: if internalUser();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
