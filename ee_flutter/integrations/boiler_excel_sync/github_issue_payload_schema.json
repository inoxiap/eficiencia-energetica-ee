{
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAtUtc",
    "timezone",
    "collection",
    "mode",
    "windowStartUtc",
    "affectedDates",
    "delivery",
    "datasets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer"
    },
    "generatedAtUtc": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "collection": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "incremental",
        "date",
        "full",
        "acknowledgement"
      ]
    },
    "windowStartUtc": {
      "type": "string"
    },
    "affectedDates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delivery": {
      "type": "object",
      "required": [
        "status",
        "batchId",
        "cursorStartUtc",
        "cursorEndUtc",
        "targetLocalDate",
        "rawRowCount"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "acknowledged"
          ]
        },
        "batchId": {
          "type": "string"
        },
        "cursorStartUtc": {
          "type": "string"
        },
        "cursorEndUtc": {
          "type": "string"
        },
        "targetLocalDate": {
          "type": "string"
        },
        "rawRowCount": {
          "type": "integer"
        },
        "remainingDates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acknowledgedAtUtc": {
          "type": "string"
        }
      }
    },
    "datasets": {
      "type": "object",
      "required": [
        "raw",
        "intervals",
        "hourly",
        "daily"
      ],
      "properties": {
        "raw": {
          "$ref": "#/definitions/dataset"
        },
        "intervals": {
          "$ref": "#/definitions/dataset"
        },
        "hourly": {
          "$ref": "#/definitions/dataset"
        },
        "daily": {
          "$ref": "#/definitions/dataset"
        }
      }
    }
  },
  "definitions": {
    "dataset": {
      "type": "object",
      "required": [
        "headers",
        "rows"
      ],
      "properties": {
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array"
          }
        }
      }
    }
  }
}
